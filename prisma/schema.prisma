generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  price       String
  category    String
  imageUrl    String
  description String
  story       String
  limitBay    Int?
  state       String    @default("exist")
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

